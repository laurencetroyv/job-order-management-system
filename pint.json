{
    "preset": "laravel",
    "rules": {
        "no_unused_imports": true,
        "no_unneeded_import_alias": true,
        "binary_operator_spaces": {
            "operators": {
                "=>": "align_single_space_minimal"
            }
        },
        "method_argument_space": {
            "on_multiline": "ensure_fully_multiline"
        },
        "ordered_imports": {
            "sort_algorithm": "length",
            "imports_order": [
                "class",
                "function",
                "const"
            ]
        }
    }
}
